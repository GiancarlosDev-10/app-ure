# ============================================
# NEXTAUTH
# ============================================
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# ============================================
# SUPABASE
# ============================================
# URL del proyecto (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# anon/public key (no se usa para datos sensibles, solo si se necesita en cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key: SOLO server-side. Nunca exponer con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# OPENAI
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================
# LÍMITES DE NEGOCIO (fallback si no vienen de BD)
# ============================================
DEFAULT_QUESTIONS_LIMIT=2000
DEFAULT_ALERT_THRESHOLD=1800
DEFAULT_EXPIRATION_DATE=2026-09-30
